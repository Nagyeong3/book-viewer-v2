APP_NAME=Book Viewer V2
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9056
LOG_LEVEL=INFO
ENABLE_API_DOCS=false

DATABASE_URL=postgresql://user:password@localhost:5432/book_viewer
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=10
DATABASE_COMMAND_TIMEOUT=30

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT=30
ES_DOCUMENT_ALIAS=rag-documents
ES_MAINTENANCE_ALIAS=rag-maintenance

EMBEDDING_PROVIDER=vllm
EMBEDDING_BASE_URL=http://localhost:4070
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_FACTOR=1.5

RETRIEVAL_TITLE_BOOST=3.0
RETRIEVAL_KEYWORD_WEIGHT=0.5
RETRIEVAL_VECTOR_WEIGHT=0.5
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RAG_TOP_K=8
RAG_CONTEXT_MAX_CHARS=24000

LLM_PROVIDER=litellm
LITELLM_BASE_URL=http://localhost:4070/v1
LITELLM_API_KEY=
LLM_MODEL=gpt-oss-120b-vllm
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_FACTOR=1.5
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

NEXT_PUBLIC_API_BASE_URL=http://localhost:9056
